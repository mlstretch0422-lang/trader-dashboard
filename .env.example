# Signal Bridge local runtime configuration.
# Copy this file to .env.local and fill values there. Never commit .env.local.

DISCORD_WEBHOOK_URL=
# Optional dedicated channel for scheduled desk/news posts. If omitted, the Worker
# falls back to DISCORD_WEBHOOK_URL.
DISCORD_INTELLIGENCE_WEBHOOK_URL=
TV_WEBHOOK_SECRET=
JOURNAL_INGEST_TOKEN=
SIGNAL_BRIDGE_TEST_TOKEN=

# Optional professional economic-calendar provider.
# Signal Bridge fails closed when this is absent; it never converts provider
# unavailability into a false "no red news" state.
TRADING_ECONOMICS_API_KEY=

# Discord Journal Intelligence interaction app.
# DISCORD_BOT_TOKEN is only used locally for one-time slash/context command registration.
# Do not deploy it to the Worker and never commit it.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_JOURNAL_CHANNEL_ID=

DASHBOARD_PORT=8000

# Webhook mode is the safe default: no synthetic trade signal is generated.
SIGNAL_BRIDGE_MODE=webhook
