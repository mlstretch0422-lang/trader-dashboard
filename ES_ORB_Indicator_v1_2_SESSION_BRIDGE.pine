//@version=6
indicator("ES/MES ORB Retest Indicator v1.2 SESSION BRIDGE", overlay=true, max_labels_count=100, max_lines_count=100)

// v1.2 keeps the v1.1 ORB / breakout / retest / context / signal logic intact.
// The added Session Bridge is an integration layer only: it emits durable lifecycle
// events for Signal Bridge's Morning Desk + Discord bot. It does not add a new edge.

grpTime = "Time Settings"
i_timezone   = input.string("America/New_York", "Timezone", options=["America/New_York", "America/Chicago", "UTC"], group=grpTime)
i_orbStart   = input.string("0800", "ORB Start (HHMM)", group=grpTime)
i_orbEnd     = input.string("0815", "ORB End (HHMM)", group=grpTime)
i_tradeStart = input.string("0930", "Trade Start (HHMM)", group=grpTime)
i_tradeEnd   = input.string("1100", "Trade End (HHMM)", group=grpTime)

grpEntry = "Entry Settings"
i_bodyMinPct    = input.float(0.35, "Min Body % of ORB Range", minval=0.0, maxval=2.0, step=0.05, group=grpEntry)
i_bodyMinAtr    = input.float(0.75, "Min Body × ATR", minval=0.0, maxval=5.0, step=0.05, group=grpEntry)
i_atrLen        = input.int(14, "ATR Length", minval=1, group=grpEntry)
i_retestMode    = input.string("Midpoint", "Retest Mode", options=["Breakout", "Boundary", "Midpoint"], group=grpEntry)
i_retestTimeout = input.int(60, "Retest Timeout Bars", minval=1, maxval=300, group=grpEntry)

grpFilters = "Filters"
i_useVWAP  = input.bool(true, "Use VWAP Alignment", group=grpFilters)
i_useEMA   = input.bool(false, "Use EMA Alignment", group=grpFilters)
i_emaLen   = input.int(50, "EMA Length", minval=1, group=grpFilters)
i_minRange = input.float(5.0, "Min ORB Range Points", minval=0.25, step=0.25, group=grpFilters)
i_maxRange = input.float(50.0, "Max ORB Range Points", minval=1.0, step=0.5, group=grpFilters)

grpBridge = "Signal Bridge Session Lifecycle"
i_enableSessionBridge = input.bool(true, "Enable Session Lifecycle alert() calls", group=grpBridge)
i_premarketSnapshot    = input.string("0755", "PREMARKET Snapshot (HHMM)", group=grpBridge)
i_preopenSnapshot      = input.string("0915", "PREOPEN Snapshot (HHMM)", group=grpBridge)
i_bridgeNote           = input.string("Signal Bridge Session Bridge v1.2", "Lifecycle Source Label", group=grpBridge)

grpDisplay = "Display"
i_showDashboard = input.bool(true, "Show Dashboard", group=grpDisplay)
i_showSignals = input.bool(true, "Show Signals", group=grpDisplay)

f_timeToMins(string hhmm) =>
    float h = str.tonumber(str.substring(hhmm, 0, 2))
    float m = str.tonumber(str.substring(hhmm, 2, 4))
    int(h * 60 + m)

f_currentMins() =>
    hour(time, i_timezone) * 60 + minute(time, i_timezone)

f_inWindow(string startHHMM, string endHHMM) =>
    int curMins = f_currentMins()
    int startMins = f_timeToMins(startHHMM)
    int endMins = f_timeToMins(endHHMM)
    startMins < endMins ? (curMins >= startMins and curMins < endMins) : (curMins >= startMins or curMins < endMins)

// Fires on the first chart bar whose opening timestamp reaches/passes a clock time.
// ES/MES charts include overnight data, so this remains stable across the normal session.
f_reachedTime(string hhmm) =>
    int targetMins = f_timeToMins(hhmm)
    int curMins = f_currentMins()
    int prevMins = na(time[1]) ? curMins : hour(time[1], i_timezone) * 60 + minute(time[1], i_timezone)
    bool sameDate = not na(time[1]) and year(time, i_timezone) == year(time[1], i_timezone) and month(time, i_timezone) == month(time[1], i_timezone) and dayofmonth(time, i_timezone) == dayofmonth(time[1], i_timezone)
    sameDate and curMins >= targetMins and prevMins < targetMins

f_numOrNull(float value) =>
    na(value) ? "null" : str.tostring(value, "#.####")

f_text(string value) =>
    "\"" + value + "\""

f_nullableText(string value) =>
    str.length(value) == 0 ? "null" : f_text(value)

f_contextLabel(bool longOk, bool shortOk) =>
    not i_useVWAP and not i_useEMA ? "" : longOk and not shortOk ? "LONG_CONTEXT" : shortOk and not longOk ? "SHORT_CONTEXT" : "MIXED_CONTEXT"

f_firstBreakLabel(int code) =>
    code == 1 ? "HIGH_FIRST" : code == -1 ? "LOW_FIRST" : code == 2 ? "BOTH_OR_SAME_BAR" : "NONE"

f_payload(string stage, string side, string note, string setup, string target, string outcome, string bias, float price, float highLevel, float lowLevel, float midLevel, float rangePoints) =>
    "{" +
      "\"symbol\":" + f_text(syminfo.ticker) + "," +
      "\"stage\":" + f_text(stage) + "," +
      "\"side\":" + f_nullableText(side) + "," +
      "\"price\":" + f_numOrNull(price) + "," +
      "\"strategy\":" + f_text("ES/MES ORB Indicator v1.2 Session Bridge") + "," +
      "\"note\":" + f_text(note) + "," +
      "\"timeframe\":" + f_text(timeframe.period) + "," +
      "\"orb_high\":" + f_numOrNull(highLevel) + "," +
      "\"orb_low\":" + f_numOrNull(lowLevel) + "," +
      "\"orb_mid\":" + f_numOrNull(midLevel) + "," +
      "\"range_points\":" + f_numOrNull(rangePoints) + "," +
      "\"bias\":" + f_nullableText(bias) + "," +
      "\"setup\":" + f_nullableText(setup) + "," +
      "\"target\":" + f_nullableText(target) + "," +
      "\"outcome\":" + f_nullableText(outcome) + "," +
      "\"event_time\":" + str.tostring(time) +
    "}"

f_emit(string stage, string side, string note, string setup, string target, string outcome, string bias, float price, float highLevel, float lowLevel, float midLevel, float rangePoints) =>
    if i_enableSessionBridge
        alert(f_payload(stage, side, note, setup, target, outcome, bias, price, highLevel, lowLevel, midLevel, rangePoints), alert.freq_all)

newDay = ta.change(dayofmonth(time, i_timezone)) != 0
inOrbWindow = f_inWindow(i_orbStart, i_orbEnd)
inTradeWindow = f_inWindow(i_tradeStart, i_tradeEnd)

var float orbHigh = na
var float orbLow = na
var float orbMid = na
var bool orbDone = false
var bool signalToday = false
var int signalDirToday = 0
var int firstOrbBreak = 0

var bool sentPremarket = false
var bool sentOrbFormed = false
var bool sentPreopen = false
var bool sentOpen = false
var bool sentSessionClose = false
var int sentSetupBar = na

if newDay
    orbHigh := na
    orbLow := na
    orbMid := na
    orbDone := false
    signalToday := false
    signalDirToday := 0
    firstOrbBreak := 0
    sentPremarket := false
    sentOrbFormed := false
    sentPreopen := false
    sentOpen := false
    sentSessionClose := false
    sentSetupBar := na

if inOrbWindow and not orbDone
    orbHigh := na(orbHigh) ? high : math.max(orbHigh, high)
    orbLow := na(orbLow) ? low : math.min(orbLow, low)

if not inOrbWindow and not orbDone and not na(orbHigh) and not na(orbLow)
    orbDone := true
    orbMid := (orbHigh + orbLow) / 2.0

orbRange = orbDone ? orbHigh - orbLow : na
orbRangeOk = orbDone and orbRange >= i_minRange and orbRange <= i_maxRange

atrVal = ta.atr(i_atrLen)
barBody = math.abs(close - open)
bodyPctOfRange = orbRangeOk ? barBody / orbRange : 0.0
bodyVsAtr = atrVal > 0 ? barBody / atrVal : 0.0
displacementOk = bodyPctOfRange >= i_bodyMinPct or bodyVsAtr >= i_bodyMinAtr

vwapVal = ta.vwap(hlc3)
emaVal = ta.ema(close, i_emaLen)
longContextOk = (not i_useVWAP or close > vwapVal) and (not i_useEMA or close > emaVal)
shortContextOk = (not i_useVWAP or close < vwapVal) and (not i_useEMA or close < emaVal)
contextLabel = f_contextLabel(longContextOk, shortContextOk)

// Track which ORB side actually traded first in realtime. If a historical bar spans
// both sides, record it as ambiguous rather than pretending the OHLC data proves order.
if orbDone and firstOrbBreak == 0 and not inOrbWindow
    bool brokeHigh = high > orbHigh
    bool brokeLow = low < orbLow
    if brokeHigh and brokeLow
        firstOrbBreak := 2
    else if brokeHigh
        firstOrbBreak := 1
    else if brokeLow
        firstOrbBreak := -1

// Session lifecycle snapshots. Time events are emitted at the first new chart bar
// reaching each clock. event_time is the chart epoch; the Worker normalizes it to ISO.
if barstate.isnew and not sentPremarket and f_reachedTime(i_premarketSnapshot)
    sentPremarket := true
    f_emit("PREMARKET", "", i_bridgeNote + " · pre-ORB snapshot", "", "", "", contextLabel, close, na, na, na, na)

if orbDone and not sentOrbFormed
    sentOrbFormed := true
    string rangeOutcome = orbRangeOk ? "RANGE_VALID" : "RANGE_OUTSIDE_FILTER"
    f_emit("ORB_FORMED", "", "Opening range formed", "", "", rangeOutcome, contextLabel, close, orbHigh, orbLow, orbMid, orbRange)

if barstate.isnew and not sentPreopen and f_reachedTime(i_preopenSnapshot)
    sentPreopen := true
    f_emit("PREOPEN", "", "Pre-open snapshot · first ORB break " + f_firstBreakLabel(firstOrbBreak), "", "", f_firstBreakLabel(firstOrbBreak), contextLabel, close, orbHigh, orbLow, orbMid, orbRange)

if barstate.isnew and not sentOpen and f_reachedTime(i_tradeStart)
    sentOpen := true
    f_emit("OPEN_SNAPSHOT", "WAIT", "Trade window opened · first ORB break " + f_firstBreakLabel(firstOrbBreak), "", "", f_firstBreakLabel(firstOrbBreak), contextLabel, close, orbHigh, orbLow, orbMid, orbRange)

var int setupDir = 0
var int setupBar = na
var bool retestSeen = false

if newDay
    setupDir := 0
    setupBar := na
    retestSeen := false

canSeek = orbRangeOk and inTradeWindow and not signalToday

if canSeek and setupDir == 0 and displacementOk
    if close > orbHigh and longContextOk
        setupDir := 1
        setupBar := bar_index
        retestSeen := i_retestMode == "Breakout"
    else if close < orbLow and shortContextOk
        setupDir := -1
        setupBar := bar_index
        retestSeen := i_retestMode == "Breakout"

bool setupTimedOut = setupDir != 0 and not na(setupBar) and bar_index - setupBar > i_retestTimeout
if setupTimedOut
    int expiredDir = setupDir
    string expiredSide = expiredDir == 1 ? "LONG" : "SHORT"
    if barstate.isconfirmed
        f_emit("WAIT", expiredSide, "Setup candidate expired before confirmation", "ORB " + i_retestMode + " retest", "", "SETUP_TIMEOUT", contextLabel, close, orbHigh, orbLow, orbMid, orbRange)
    setupDir := 0
    setupBar := na
    retestSeen := false

longRetestLevel = i_retestMode == "Midpoint" ? orbMid : orbHigh
shortRetestLevel = i_retestMode == "Midpoint" ? orbMid : orbLow

if setupDir == 1 and not retestSeen and low <= longRetestLevel
    retestSeen := true
if setupDir == -1 and not retestSeen and high >= shortRetestLevel
    retestSeen := true

longSig = canSeek and setupDir == 1 and retestSeen and close > orbHigh and displacementOk and longContextOk
shortSig = canSeek and setupDir == -1 and retestSeen and close < orbLow and displacementOk and shortContextOk

// Emit a setup-state record on the confirmed bar where a fresh candidate exists.
// The existing Long/Short alertcondition remains the actual signal surface.
if barstate.isconfirmed and setupDir != 0 and not na(setupBar) and (na(sentSetupBar) or sentSetupBar != setupBar)
    sentSetupBar := setupBar
    string setupSide = setupDir == 1 ? "LONG" : "SHORT"
    string setupState = retestSeen ? "RETEST_SEEN" : "AWAITING_RETEST"
    f_emit("SETUP", setupSide, "ORB candidate · " + setupState, "ORB " + i_retestMode + " retest", "", setupState, contextLabel, close, orbHigh, orbLow, orbMid, orbRange)

if longSig or shortSig
    signalToday := true
    signalDirToday := longSig ? 1 : -1
    setupDir := 0

// The session close is a state record, even when no signal occurred.
if barstate.isnew and not sentSessionClose and f_reachedTime(i_tradeEnd)
    sentSessionClose := true
    string closeSide = signalDirToday == 1 ? "LONG" : signalDirToday == -1 ? "SHORT" : "WAIT"
    string closeOutcome = signalToday ? "SIGNAL_RECORDED · FIRST_BREAK_" + f_firstBreakLabel(firstOrbBreak) : "NO_SIGNAL · FIRST_BREAK_" + f_firstBreakLabel(firstOrbBreak)
    string closeNote = signalToday ? "Trade window closed after a recorded setup signal" : "Trade window closed with no qualifying signal"
    f_emit("SESSION_CLOSE", closeSide, closeNote, signalToday ? "ORB " + i_retestMode + " retest" : "", "", closeOutcome, contextLabel, close, orbHigh, orbLow, orbMid, orbRange)

plot(orbRangeOk ? orbHigh : na, "ORB High", color=color.new(color.green, 0), linewidth=2)
plot(orbRangeOk ? orbLow : na, "ORB Low", color=color.new(color.red, 0), linewidth=2)
plot(orbRangeOk ? orbMid : na, "ORB Mid", color=color.new(color.orange, 20), linewidth=1)
plot(i_useVWAP ? vwapVal : na, "VWAP", color=color.new(color.blue, 40), linewidth=1)
plot(i_useEMA ? emaVal : na, "EMA", color=color.new(color.aqua, 50), linewidth=1)

plotshape(i_showSignals and setupDir == 1 and bar_index == setupBar, title="Long Breakout", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.tiny, text="BRK")
plotshape(i_showSignals and setupDir == -1 and bar_index == setupBar, title="Short Breakout", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, text="BRK")
plotshape(i_showSignals and longSig, title="Long Ready", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="LONG")
plotshape(i_showSignals and shortSig, title="Short Ready", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small, text="SHORT")

// Existing permanent setup alerts remain compatible with the v1.1 integration path.
alertcondition(longSig, title="Long Setup Ready", message="ES/MES ORB LONG setup ready")
alertcondition(shortSig, title="Short Setup Ready", message="ES/MES ORB SHORT setup ready")

var table dash = table.new(position.top_right, 2, 10, border_width=1)
if i_showDashboard and barstate.islast
    int readyCount = (orbDone ? 1 : 0) + (str.length(contextLabel) > 0 ? 1 : 0) + (setupDir != 0 or signalToday ? 1 : 0) + (signalToday ? 1 : 0)
    table.cell(dash, 0, 0, "ES/MES ORB v1.2", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(dash, 1, 0, "SESSION BRIDGE", text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.cell(dash, 0, 1, "ORB")
    table.cell(dash, 1, 1, inOrbWindow ? "BUILDING" : orbDone ? "DONE" : "WAIT")
    table.cell(dash, 0, 2, "Range")
    table.cell(dash, 1, 2, orbDone ? str.tostring(orbRange, "#.##") : "na")
    table.cell(dash, 0, 3, "Range OK")
    table.cell(dash, 1, 3, orbRangeOk ? "YES" : "NO")
    table.cell(dash, 0, 4, "Trade Window")
    table.cell(dash, 1, 4, inTradeWindow ? "OPEN" : "CLOSED")
    table.cell(dash, 0, 5, "Context")
    table.cell(dash, 1, 5, str.length(contextLabel) > 0 ? contextLabel : "NOT SCORED")
    table.cell(dash, 0, 6, "Setup")
    table.cell(dash, 1, 6, setupDir == 1 ? "LONG" : setupDir == -1 ? "SHORT" : "NONE")
    table.cell(dash, 0, 7, "Retest")
    table.cell(dash, 1, 7, retestSeen ? "SEEN" : "NO")
    table.cell(dash, 0, 8, "Signal Today")
    table.cell(dash, 1, 8, signalToday ? (signalDirToday == 1 ? "LONG" : "SHORT") : "NO")
    table.cell(dash, 0, 9, "Bridge State")
    table.cell(dash, 1, 9, i_enableSessionBridge ? str.tostring(readyCount) + "/4 LOCAL" : "OFF")
