<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.signalbridge.dailybrief</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>exec /bin/zsh "$HOME/.copilot/repos/trader-dashboard/trading_os/src/integrations/run_launchd.sh"</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <key>RUN_MODE</key>
      <string>full</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/signal-bridge-launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/signal-bridge-launchd.err.log</string>

    <key>RunAtLoad</key>
    <true/>
  </dict>
</plist>
