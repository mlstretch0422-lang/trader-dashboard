indicator("ORB Retest Indicator v1.0 (skeleton)", overlay=true)

// Inputs (canonical)
orbStart = input.string("0800", "ORB Start (HHMM)")
orbEnd = input.string("0815", "ORB End (HHMM)")
useVWAP = input.bool(true, "Use VWAP")
useEMA = input.bool(false, "Use EMA")
emaLen = input.int(50, "EMA Length")

// ORB build (placeholder)
